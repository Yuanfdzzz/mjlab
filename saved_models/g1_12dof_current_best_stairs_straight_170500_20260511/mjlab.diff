+  cost = torch.sum(tilt * in_contact, dim=1)
+  contact_count = torch.clamp(torch.sum(in_contact), min=1)
+  env.extras["log"]["Metrics/support_foot_tilt_mean"] = (
+    torch.sum(torch.sqrt(tilt) * in_contact) / contact_count
